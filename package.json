{
  "name": "pi-micromanager",
  "version": "0.1.0-alpha.1",
  "description": "A human-steerable control plane for Pi agent swarms",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "multi-agent",
    "workflow",
    "dag",
    "pi-web"
  ],
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:adversarial": "npm run build && node --test tests/adversarial-interventions.test.mjs tests/adversarial-scheduler.test.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:e2e:faux": "node scripts/durable-auth-smoke.mjs --mode faux",
    "test:e2e:contracts": "node --test tests/e2e-contract.test.mjs",
    "test:e2e:local-luna": "node scripts/local-pi-oauth-smoke.mjs",
    "test:e2e:hosted": "node scripts/hosted-acceptance.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@jmfederico/pi-web": "^1.202610.1",
    "@types/node": "^24.13.3",
    "playwright": "1.64.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@jmfederico/pi-web": "^1.202610.1"
  },
  "piWeb": {
    "plugins": [
      {
        "id": "micromanager",
        "browserRoot": "dist/pi-web",
        "module": "dist/pi-web/browser.js",
        "serverModule": "dist/pi-web/server.js",
        "machineSpecific": true,
        "defaultEnabled": false
      }
    ]
  },
  "pi": {
    "extensions": [
      "./dist/runtime/companion.js"
    ]
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0"
  }
}
